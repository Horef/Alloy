# Copy to .env and replace the placeholder. Never commit .env.
GEMINI_API_KEY=replace-me
# Required only when gemini.transport = "apigee". Never commit the real key.
APIGEE_API_KEY=replace-me
# Required only when gemini.transport = "openai" (unless openai_api_key_env is empty).
OPENAI_API_KEY=replace-me
# gemini.transport = "bedrock" uses the AWS credential chain instead, for example:
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_REGION=us-east-1
# or a Bedrock API key: AWS_BEARER_TOKEN_BEDROCK=replace-me
